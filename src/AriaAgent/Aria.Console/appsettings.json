{
  "OllamaWebSearch": {
    "BaseUrl": "https://ollama.com",
    "ApiKeyFile": "/path/to/ollama-web-mcpserver/src/OllamaMCPServer/OllamaMCPServer/api.key",
    "Enabled": true
  },
  "Azure": {
    "TenantId": "consumers",
    "ApplicationId": ""
  },
  "Google": {
    "CredentialsFile": "~/.aria-agent/google-credentials.json"
  },
  "MCP": [
    {
      "Name": "Web Search",
      "Command": "/usr/local/share/dotnet/dotnet",
      "Arguments": [
        "run", "--project", "/path/to/ollama-web-mcpserver/src/OllamaMCPServer/OllamaMCPServer/OllamaMCPServer.csproj"
      ],
      "Enabled": true
    },
    {
      "Name": "Example Server",
      "Command": "/usr/bin/node",
      "Arguments": ["/path/to/server.js"],
      "Enabled": false,
      "Environment": {
        "API_KEY": ""
      }
    }
  ],
  "LocalLLM": {
    "Enabled": false,
    "ModelSources": [
      {
        "Name": "Local LLM - LAN server",
        "Url": "http://your-llm-host:1234/v1",
        "ApiKeyFile": "/path/to/api.key",
        "Models": [
          "qwen3.6-35b-a3b-claude-4.7-opus-reasoning-distilled-apex"
        ]
      },
      {
        "Name": "Local LLM - Mac (localhost)",
        "Url": "http://127.0.0.1:1234/v1",
        "ApiKeyFile": "",
        "Models": [
          "qwen3.6-35b-a3b-claude-4.7-opus-distilled-mlx-oq4",
          "gemma-4-26b-a4b-it-mlx"
        ]
      }
    ]
  }
}
