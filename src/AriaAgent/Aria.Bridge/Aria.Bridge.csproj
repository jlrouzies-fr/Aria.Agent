<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>aria-bridge</AssemblyName>
        <RootNamespace>Aria.Bridge</RootNamespace>
        <Version>1.25.5-beta</Version>
        <AssemblyVersion>1.24.1.0</AssemblyVersion>
        <FileVersion>1.24.1.0</FileVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
        <PackageReference Include="Microsoft.Playwright" Version="1.49.0" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.8" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.5" />
        <!-- EF Core Sqlite 9.0.5 transitively pulls SQLitePCLRaw 2.1.10, flagged by GHSA-2m69-gcr7-jv3q
             (affects <= 2.1.11, no 2.x patch). 3.0.x is the unaffected line; verified working with EF 9. -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
        <PackageReference Include="Porta.Pty" Version="1.0.7" />
        <PackageReference Include="System.Numerics.Tensors" Version="10.0.6" />
        <PackageReference Include="Whisper.net" Version="1.9.1" />
        <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Aria.Shared/Aria.Shared.csproj" />
        <ProjectReference Include="../Aria.Tools/Aria.Tools.csproj" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Aria.Tests" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="BuiltinTools\BuiltinTools.CommandsIndex.cs">
        <DependentUpon>BuiltinTools.cs</DependentUpon>
      </Compile>
      <Compile Update="BuiltinTools\BuiltinTools.File.cs">
        <DependentUpon>BuiltinTools.cs</DependentUpon>
      </Compile>
      <Compile Update="BuiltinTools\BuiltinTools.Shell.cs">
        <DependentUpon>BuiltinTools.cs</DependentUpon>
      </Compile>
      <Compile Update="BuiltinTools\BuiltinTools.Web.cs">
        <DependentUpon>BuiltinTools.cs</DependentUpon>
      </Compile>
      <Compile Update="BuiltinTools\BuiltinTools.Memory.cs">
        <DependentUpon>BuiltinTools.cs</DependentUpon>
      </Compile>
      <Compile Update="BuiltinTools\BuiltinTools.Screenshot.cs">
        <DependentUpon>BuiltinTools.cs</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
