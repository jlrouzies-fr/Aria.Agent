<body class="font-terminal bg-bg-base">
    @* Whole app is one interactive Server circuit → navigation is true SPA: the layout,
       NavMenu and circuit persist across route changes (no per-route island rebuild). *@
    <Routes @rendermode="InteractiveServer" />

<ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="lib/xterm/xterm.js"></script>
    <script src="lib/xterm/xterm-addon-fit.js"></script>
