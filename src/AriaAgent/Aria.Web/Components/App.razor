<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />

    <!-- Tailwind Play CDN — scans DOM for classes dynamically -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'bg-base':    '#252525',
                        'bg-panel':   '#2d2d2d',
                        'bg-surface': '#353535',
                        'bg-hover':   '#3a2424',
                        'b-dim':      '#5a4040',
                        'b-normal':   '#8a5252',
                        'b-active':   '#b06060',
                        'b-glow':     '#e07070',
                        't-dead':     '#9a8282',
                        't-muted':    '#cc9898',
                        't-normal':   '#e08888',
                        't-bright':   '#f5a0a0',
                        't-title':    '#f06060',
                        't-body':     '#eed0d0',
                        'gold-dim':   '#6a5010',
                        'gold':       '#9b7920',
                        'gold-bright':'#d4a020',
                    },
                    fontFamily: {
                        terminal: ['Consolas', 'Courier New', 'monospace'],
                    },
                    boxShadow: {
                        'glow-sm': '0 0 6px rgba(204,0,0,0.4)',
                        'glow-md': '0 0 12px rgba(204,0,0,0.5)',
                        'glow-lg': '0 0 24px rgba(204,0,0,0.4)',
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts fallback for Consolas-like monospace -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap" rel="stylesheet" />

