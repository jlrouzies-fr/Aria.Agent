@using Aria.Agent
@using Aria.Web.Data
@using Aria.Tools
@using Aria.Web.Helpers
@using Aria.Web.Components.Pages
@using Aria.Web.Components.Shared
@using Markdig
@using System.Text.Json
@using System.Security.Cryptography
@namespace Aria.Web.Components.Layout

@code {
    [CascadingParameter(Name = "NavMenu")]
    public NavMenu Menu { get; set; } = null!;
}

@* ── Vigil full-screen modal ──────────────────────────────────────────── *@
@if (Menu.SessionState.VigilModalOpen)
{
    <div class="vigil-backdrop" @onclick="Menu.SessionState.CloseVigilModal">
        <div class="vigil-modal" @onclick:stopPropagation="true">
            <div class="vigil-modal-header">
                <span class="vigil-modal-title">// VIGIL SCHEDULER</span>
                <button class="vigil-close-btn" @onclick="Menu.SessionState.CloseVigilModal">✕ CLOSE</button>
            </div>
            <div class="vigil-modal-body">
                <CronSchedulerPanel PrefillTask="@Menu.SessionState.VigilPrefillTask"
                                    PrefillCogitationId="@Menu.SessionState.VigilPrefillCogitationId"
                                    OnOpenCogitation="Menu.OnVigilCogitation" />
            </div>
        </div>
    </div>
}

